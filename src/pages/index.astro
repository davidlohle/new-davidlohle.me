---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import { loadCanvasData } from '../lib/loadCanvasData';
import { fmtMonthYear, fmtMonthYearLong, postNumber } from '../lib/format';
import PhotoOverlay from '../components/PhotoOverlay.astro';
import PostOverlay from '../components/PostOverlay.astro';
import CodeOverlay from '../components/CodeOverlay.astro';
import '../styles/tokens.css';
import '../styles/canvas.css';
import '../styles/ui.css';
import '../styles/editable.css';

const {
  posts,
  renderedPosts,
  photos,
  renderedPhotos,
  photoCount,
  photoLatest,
  modalImagePreloads,
  projects,
  stickies,
  boxes,
  canvasPhotos,
  readmes,
  codeblocks,
  photoById,
  arrows,
  arrowKinds,
  arrowSvgs,
  photoOptions,
  moduleDataForEditor,
  readmeDataForEditor,
  codeblockDataForEditor,
  stickyDataForEditor,
  boxDataForEditor,
  photoDataForEditor,
  arrowDataForEditor,
  mod,
} = await loadCanvasData();

// Section deep-links — /about, /now, etc. all render this same page;
// the canvas script reads location.pathname on load and pans to the
// matching section. Each route gets its own <title> + description.
const SECTION_META: Record<string, { title: string; description: string }> = {
  about: {
    title: `About · ${site.brand.name}`,
    description: 'About David Lohle — programmer, systems architect, NYC-based.',
  },
  now: {
    title: `Now · ${site.brand.name}`,
    description: "What David Lohle is currently up to.",
  },
  photo: {
    title: `Photography · ${site.brand.name}`,
    description: "Photographs by David Lohle — birds, cityscapes, the in-between.",
  },
  projects: {
    title: `Projects · ${site.brand.name}`,
    description: "Personal software projects by David Lohle — long-running tools, experiments, and side-quests.",
  },
  writing: {
    title: `Writing · ${site.brand.name}`,
    description: "Essays and notes by David Lohle on engineering, platforms, and the long-term craft.",
  },
  contact: {
    title: `Contact · ${site.brand.name}`,
    description: "Get in touch with David Lohle.",
  },
};
const pathSection = Astro.url.pathname.replace(/^\/|\/$/g, '').toLowerCase();
const sectionMeta = SECTION_META[pathSection];

// Per-post deep links: /writing/<slug>. The route is generated by
// src/pages/writing/[slug].astro, which re-renders this page. We look up the
// rendered post here so the <title>/description/OG cards reflect the post,
// not the generic Writing section.
const postSlugMatch = Astro.url.pathname.match(/^\/writing\/([^/]+)\/?$/);
const postEntry = postSlugMatch
  ? renderedPosts.find((rp) => rp.post.id === postSlugMatch[1])
  : null;
const postMeta = postEntry
  ? {
      title: `${postEntry.crumb} · ${site.brand.name}`,
      description: postEntry.post.data.summary ?? `${postEntry.crumb} — an essay by David Lohle.`,
    }
  : null;

const pageTitle = postMeta?.title ?? sectionMeta?.title ?? site.brand.name;
const pageDescription = postMeta?.description
  ?? sectionMeta?.description
  ?? "David Lohle's spatial canvas — a roam-and-zoom portfolio of writing, photography, and personal software projects.";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://davidlohle.me').toString();
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://davidlohle.me').toString();
const ogType = postEntry ? 'article' : 'website';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{pageTitle}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content={pageDescription}>
<meta name="theme-color" content="#f1ead7">
<meta name="author" content="David Lohle">
<link rel="canonical" href={canonicalUrl}>
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta property="og:type" content={ogType}>
<meta property="og:title" content={pageTitle}>
<meta property="og:description" content={pageDescription}>
<meta property="og:url" content={canonicalUrl}>
<meta property="og:image" content={ogImage}>
<meta property="og:site_name" content={site.brand.name}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={pageTitle}>
<meta name="twitter:description" content={pageDescription}>
<meta name="twitter:image" content={ogImage}>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/RecklessStandardXL-Regular.woff2">
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/RecklessStandardXL-RegularItalic.woff2">
<link rel="preload" as="font" href="/fonts/DavidFontInk.otf" type="font/otf" crossorigin>
<link rel="preload" as="font" href="/fonts/DavidFontFelt.otf" type="font/otf" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&family=Geist+Mono:wght@300;400;500&family=Geist:wght@300;400;500;600&display=swap" rel="stylesheet">
{modalImagePreloads.map((p) => (
  <link rel="preload" as="image" href={p.src} imagesrcset={p.srcset} imagesizes={p.sizes} />
))}
</head>
<body>

<div id="viewport">
  <div id="world" style={`--compass: "${site.compass}";`}>

    {/* HERO */}
    <div class="mod" id="m-hero" {...mod('hero')}>
      <span class="yo">{site.hero.greeting}</span>
      <h1>
        {site.hero.intro}
        <span class="verb" data-i="0">cooking</span>,
        <span class="verb" data-i="1">biking</span>,
        <span class="verb" data-i="2">photographing</span>
        <span class="strike" data-i="3">skilled whiteboarder</span>
        <span class="correction">{site.hero.correction}</span>
      </h1>
      <div class="sub">
        {site.hero.subtitle.map((s, i) => (
          <>{i > 0 && <> <span class="dot">●</span> </>}{s}</>
        ))}
      </div>
    </div>

    {/* ABOUT */}
    <div class="mod" id="m-about" {...mod('about')}>
      <span class="pin">§ 01 — About</span>
      <h2 set:html={site.about.title} />
      {site.about.paragraphs.map((p) => <p set:html={p} />)}
      <div class="meta">{site.about.meta}</div>
    </div>


    {/* PHOTOGRAPHY */}
    <div class="mod" id="m-photo" {...mod('photo')}>
      <span class="pin accent">§ 03 — Photography</span>
      <h2 set:html={site.photo.title} />
      <p style="max-width: 60ch; margin-bottom: 14px;">{site.photo.blurb}</p>
      <div class="strip">
        {photos.map((p) => (
          <button type="button" class="ph" data-photo-id={p.id}>
            {p.data.image && (
              <Image src={p.data.image} alt={p.data.caption} widths={[360, 720]} sizes="360px" draggable={false} />
            )}
            <span class="cap">{p.data.caption}</span>
          </button>
        ))}
      </div>
      <div class="meta">{photoCount} photos · last updated {fmtMonthYearLong(photoLatest)}</div>
    </div>

    {/* PROJECTS */}
    <div class="mod" id="m-projects" {...mod('projects')}>
      <span class="pin">§ 04 — Projects</span>
      <h2 set:html={site.projectsIntro.title} />
      <div class="grid">
        {projects.map((proj) => (
          <button type="button" class="proj" data-project-id={proj.id}>
            <div class="top"><b>{proj.data.status}</b><span>{proj.data.period}</span></div>
            <h3 set:html={proj.data.name} />
            <small>{proj.data.description}</small>
          </button>
        ))}
      </div>
    </div>

    {/* WRITING */}
    <div class="mod" id="m-writing" {...mod('writing')}>
      <span class="pin">§ 05 — Writing</span>
      <h2 set:html={site.writingIntro.title} />
      <div>
        {posts.map((post, i) => (
          <button type="button" class="post" data-post-id={post.id}>
            <span class="num">{postNumber(i)}</span>
            <h3 set:html={post.data.title} />
            <span class="date">{fmtMonthYear(post.data.date)}</span>
          </button>
        ))}
      </div>
    </div>

    {/* CONTACT */}
    <div class="mod" id="m-contact" {...mod('contact')}>
      <span class="pin">§ 06 — Hello?</span>
      <h2 set:html={site.contact.title} />
      <p style="max-width: 60ch;">{site.contact.body}</p>
      <div class="actions">
        {site.contact.links.map((link) => {
          const isExternal = !link.url.startsWith('mailto:');
          return (
            <a
              class="btn"
              href={link.url}
              target={isExternal ? '_blank' : undefined}
              rel={isExternal ? 'noopener noreferrer' : undefined}
            >{link.label}</a>
          );
        })}
      </div>
    </div>

    {/* sticky notes */}
    {stickies.map((s) => (
      <div
        class="sticky"
        data-editable-type="sticky"
        data-id={s.id}
        data-x={s.data.x}
        data-y={s.data.y}
        data-rotation={s.data.rotation}
        data-color={s.data.color}
        data-z={s.data.z}
        data-mobile-x={s.data.mobile?.x}
        data-mobile-y={s.data.mobile?.y}
        data-mobile-rotation={s.data.mobile?.rotation}
        data-mobile-scale={s.data.mobile?.scale}
        data-mobile-hide={s.data.mobile?.hide ? '' : undefined}
        style={`left:${s.data.x}px;top:${s.data.y}px;transform:rotate(${s.data.rotation}deg);background:${s.data.color};z-index:${s.data.z};`}
        set:html={s.data.body}
      />
    ))}

    {/* generic boxes */}
    {boxes.map((b) => (
      <div
        class={`box ${b.data.variant}`}
        data-editable-type="box"
        data-id={b.id}
        data-x={b.data.x}
        data-y={b.data.y}
        data-width={b.data.width}
        data-height={b.data.height}
        data-rotation={b.data.rotation}
        data-variant={b.data.variant}
        data-pin={b.data.pin ?? ''}
        data-title={b.data.title ?? ''}
        data-z={b.data.z}
        data-mobile-x={b.data.mobile?.x}
        data-mobile-y={b.data.mobile?.y}
        data-mobile-rotation={b.data.mobile?.rotation}
        data-mobile-scale={b.data.mobile?.scale}
        data-mobile-hide={b.data.mobile?.hide ? '' : undefined}
        style={`left:${b.data.x}px;top:${b.data.y}px;width:${b.data.width}px;height:${b.data.height}px;transform:rotate(${b.data.rotation}deg);z-index:${b.data.z};`}
      >
        {b.data.pin && <span class="pin" set:html={b.data.pin} />}
        {b.data.title && <h3 set:html={b.data.title} />}
        <div class="body" set:html={b.data.body} />
      </div>
    ))}

    {/* canvas-positioned photos */}
    {canvasPhotos.map((cp) => {
      const photo = photoById.get(cp.data.photoId);
      const caption = photo?.data.caption ?? cp.data.photoId;
      const photoImage = photo?.data.image;
      const variant = cp.data.variant;
      const pinLabel = cp.data.pinLabel ?? '';
      return (
        <div
          class={`canvas-photo ${variant}`}
          data-editable-type="canvas-photo"
          data-id={cp.id}
          data-x={cp.data.x}
          data-y={cp.data.y}
          data-rotation={cp.data.rotation}
          data-scale={cp.data.scale}
          data-photo-id={cp.data.photoId}
          data-variant={variant}
          data-pin-label={pinLabel}
          data-z={cp.data.z}
          data-mobile-x={cp.data.mobile?.x}
          data-mobile-y={cp.data.mobile?.y}
          data-mobile-rotation={cp.data.mobile?.rotation}
          data-mobile-scale={cp.data.mobile?.scale}
          data-mobile-hide={cp.data.mobile?.hide ? '' : undefined}
          style={`left:${cp.data.x}px;top:${cp.data.y}px;transform:rotate(${cp.data.rotation}deg) scale(${cp.data.scale});z-index:${cp.data.z};`}
        >
          <div class="frame">
            {photoImage
              ? <Image src={photoImage} alt={caption} widths={[300, 600, 900]} sizes="400px" draggable={false} />
              : <div class="placeholder">{caption}</div>}
          </div>
          {variant === 'framed'
            ? pinLabel && (
                <div class="corner-cap">
                  <span class="pin">{pinLabel}</span>
                </div>
              )
            : variant === 'unframed'
              ? null
              : <div class="cap">{caption}</div>}
        </div>
      );
    })}

    {/* READMEs — composable project-detail cards (title, body, status, tags, links) */}
    {readmes.map((r) => (
      <div
        class="readme"
        data-editable-type="readme"
        data-id={r.id}
        data-x={r.data.x}
        data-y={r.data.y}
        data-width={r.data.width}
        data-rotation={r.data.rotation}
        data-project-id={r.data.projectId ?? ''}
        data-view-zoom={r.data.viewZoom}
        data-pin={r.data.pin ?? ''}
        data-title={r.data.title ?? ''}
        data-status={r.data.status ?? ''}
        data-tags={JSON.stringify(r.data.tags)}
        data-links={JSON.stringify(r.data.links)}
        data-z={r.data.z}
        data-mobile-x={r.data.mobile?.x}
        data-mobile-y={r.data.mobile?.y}
        data-mobile-width={r.data.mobile?.width}
        style={`left:${r.data.x}px;top:${r.data.y}px;width:${r.data.width}px;transform:rotate(${r.data.rotation}deg);z-index:${r.data.z};`}
      >
        {r.data.pin && <span class="pin" set:html={r.data.pin} />}
        {r.data.title && <h3 set:html={r.data.title} />}
        <div class="body" set:html={r.data.body} />
        {r.data.status && <div class="status" set:html={r.data.status} />}
        {r.data.tags.length > 0 && (
          <ul class="tags">{r.data.tags.map((t) => <li>{t}</li>)}</ul>
        )}
        {r.data.links.length > 0 && (
          <div class="links">
            {r.data.links.map((l) => (
              <a class="btn" href={l.url} target="_blank" rel="noopener">{l.label}</a>
            ))}
          </div>
        )}
      </div>
    ))}

    {/* Code-snippet icons — a small terminal glyph that opens a slide-over
        with the formatted code on click. The body is in the matching
        <template data-codeblock-id="..."> emitted by CodeOverlay. */}
    {codeblocks.map((c) => (
      <div
        class="codeblock"
        role="button"
        tabindex="0"
        aria-label={c.data.title ? `Open code: ${c.data.title.replace(/<[^>]+>/g, '')}` : 'Open code'}
        data-editable-type="codeblock"
        data-id={c.id}
        data-x={c.data.x}
        data-y={c.data.y}
        data-rotation={c.data.rotation}
        data-z={c.data.z}
        data-language={c.data.language}
        data-label={c.data.label ?? ''}
        data-title={c.data.title ?? ''}
        data-dek={c.data.dek ?? ''}
        data-code={c.data.code}
        data-mobile-x={c.data.mobile?.x}
        data-mobile-y={c.data.mobile?.y}
        data-mobile-rotation={c.data.mobile?.rotation}
        data-mobile-scale={c.data.mobile?.scale}
        data-mobile-hide={c.data.mobile?.hide ? '' : undefined}
        style={`left:${c.data.x}px;top:${c.data.y}px;transform:rotate(${c.data.rotation}deg);z-index:${c.data.z};`}
      >
        <span class="cb-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square" stroke-linejoin="miter">
            <rect x="2.5" y="4" width="19" height="16" rx="0"/>
            <path d="M6 9 l3 3 -3 3"/>
            <path d="M11 15 h6"/>
          </svg>
        </span>
        {c.data.label && <span class="cb-label" set:html={c.data.label} />}
      </div>
    ))}

    {/* Hand-drawn arrows from the arrows collection. Each renders the SVG
        file matching its `kind` field, inlined so currentColor follows
        the .arrow container's CSS color. */}
    {arrows.map((a) => (
      <div
        class="arrow"
        data-editable-type="arrow"
        data-id={a.id}
        data-kind={a.data.kind}
        data-x={a.data.x}
        data-y={a.data.y}
        data-width={a.data.width}
        data-height={a.data.height}
        data-rotation={a.data.rotation}
        data-z={a.data.z}
        data-mobile-x={a.data.mobile?.x}
        data-mobile-y={a.data.mobile?.y}
        data-mobile-rotation={a.data.mobile?.rotation}
        data-mobile-scale={a.data.mobile?.scale}
        data-mobile-hide={a.data.mobile?.hide ? '' : undefined}
        style={`left:${a.data.x}px;top:${a.data.y}px;width:${a.data.width}px;height:${a.data.height}px;transform:rotate(${a.data.rotation}deg);z-index:${a.data.z};`}
        set:html={arrowSvgs[a.data.kind] ?? ''}
      />
    ))}

  </div>
</div>

<div class="topbar">
  <div class="brand">
    {site.brand.name}<span class="dot">●</span>
    <small>{site.brand.tagline}</small>
  </div>
  <div class="nav" id="nav">
    <button data-jump="hero" class="active">Home<span class="dot">.</span></button>
    <button data-jump="about">About</button>
    <button data-jump="writing">Writing</button>
    <button data-jump="projects">Projects</button>
    <button data-jump="photo">Photos</button>
    <button data-jump="contact">Contact</button>
  </div>
</div>

<div class="controls">
  <button id="zoom-out" title="Zoom out">−</button>
  <div class="zoom" id="zoom-label">50%</div>
  <button id="zoom-in" title="Zoom in">+</button>
  <span class="reset" id="reset">RESET</span>
</div>

<div class="minimap" id="minimap">
  <div class="label">MINIMAP</div>
  <div class="coord" id="coord">x: 0 · y: 0</div>
  <div class="mini-world" id="mini-world"></div>
</div>

<div class="welcome" id="welcome">
  ✦ <span class="accent">DRAG</span> to roam · <span class="accent">SCROLL</span> to zoom · <span class="accent">0</span> to reset
</div>

<PhotoOverlay renderedPhotos={renderedPhotos} />
<PostOverlay renderedPosts={renderedPosts} />
<CodeOverlay codeblocks={codeblocks} />

{import.meta.env.DEV && (
  <script is:inline define:vars={{ photoOptions, moduleData: moduleDataForEditor, readmeData: readmeDataForEditor, codeblockData: codeblockDataForEditor, stickyData: stickyDataForEditor, boxData: boxDataForEditor, photoData: photoDataForEditor, arrowData: arrowDataForEditor, arrowKinds, arrowSvgs }}>
    window.__photoOptions = photoOptions;
    window.__moduleData = moduleData;
    window.__readmeData = readmeData;
    window.__codeblockData = codeblockData;
    window.__stickyData = stickyData;
    window.__boxData = boxData;
    window.__photoData = photoData;
    window.__arrowData = arrowData;
    window.__arrowKinds = arrowKinds;
    window.__arrowSvgs = arrowSvgs;
  </script>
)}

<script>
  import '../canvas/viewport';
</script>

</body>
</html>
